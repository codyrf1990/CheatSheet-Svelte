rules_version = '2';
// ─── V1 COMPATIBILITY NOTES ─────────────────────────────────────────────────
// firebase.json only deploys Firestore rules — no "hosting" key — so an
// accidental `firebase deploy` only pushes these rules, never a web build.
//
// The write rule below requires keys: username, normalizedUsername, schemaVersion.
// V1 client (src/lib/firebase/client.ts) writes all three via queueSave(), so
// any accidental deploy of these rules is safe for both V1 and V2 clients.
// ────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {
    // Internal sales tool — username-keyed docs, no Firebase Auth.
    // Access restricted by API key secrecy (Vite VITE_FIREBASE_* env vars).
    // TODO: add Firebase Auth and restrict to company email when/if needed:
    //   allow read, write: if request.auth.token.email.matches('.*@yourcompany\\.com');
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['username', 'normalizedUsername', 'schemaVersion'])
                   // username: non-empty string, max 50 chars
                   && request.resource.data.username is string
                   && request.resource.data.username.size() > 0
                   && request.resource.data.username.size() <= 50
                   // normalizedUsername: non-empty string, max 50 chars, must match doc ID
                   && request.resource.data.normalizedUsername is string
                   && request.resource.data.normalizedUsername.size() > 0
                   && request.resource.data.normalizedUsername.size() <= 50
                   && request.resource.data.normalizedUsername == userId
                   // schemaVersion: must be an integer (currently 1)
                   && request.resource.data.schemaVersion is int
                   && request.resource.data.schemaVersion >= 1
                   && request.resource.data.schemaVersion <= 100;

      // V2 layout: one doc per company so saves only upload what changed.
      // Purely additive — V1 clients never touch this subcollection and the
      // legacy pageSystem field on the parent doc keeps working as before.
      match /companies/{companyId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.id is string
                              && request.resource.data.id == companyId
                              && request.resource.data.name is string;
      }
    }
  }
}
